; Engine configuration file.
config_version=5

[application]
config/name="松岭余讯 | Pine Ridge Relay - Player Preview"
config/use_custom_user_dir=true
config/custom_user_dir_name="PineRidgeRelay-PlayerPreview"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
craft_wood_pick={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
craft_stone_pick={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
craft_stone_sword={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
travel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
save_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

open_crafting={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
open_backpack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}

eat_ration={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

journal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Infected"
3d_physics/layer_4="Ore"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
